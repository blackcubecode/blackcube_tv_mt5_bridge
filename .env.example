# ============================================================
# BlackCube TV -> MT5 Bridge - Environment Variables
# Copy file ini ke `.env` dan isi nilai sebenarnya.
# JANGAN COMMIT `.env` KE GIT!
# ============================================================

# Secret untuk path webhook (WAJIB - generate yang panjang & random)
# Generate dengan:
#   PowerShell: [Convert]::ToBase64String((1..48|%{[byte](Get-Random 0 255)})) -replace '[+/=]',''
#   Linux:       openssl rand -base64 48 | tr -d '/+=' | cut -c1-64
BC_WEBHOOK_SECRET=replace-with-url-safe-64-char-secret

# Path ke folder Common Files MetaTrader (WAJIB)
# Di Windows biasanya:
#   C:\Users\<USERNAME>\AppData\Roaming\MetaQuotes\Terminal\Common\Files
BC_COMMON_FILES=C:\Users\YOUR_USERNAME\AppData\Roaming\MetaQuotes\Terminal\Common\Files

# Symbol yang diizinkan (pisahkan dengan koma)
BC_ALLOWED_SYMBOLS=XAUUSD

# Batas umur sinyal (detik)
BC_MAX_AGE_SECONDS=180

# Batas jarak SL/TP (harga absolut)
BC_MAX_SL_DISTANCE=100
BC_MAX_TP_DISTANCE=200

# Log level (DEBUG, INFO, WARNING, ERROR)
BC_LOG_LEVEL=INFO